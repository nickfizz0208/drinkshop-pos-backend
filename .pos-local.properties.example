# 複製本檔並改名為 .pos-local.properties（已被 Git 忽略），再把組內共用文件上的內容貼進去。
# 本檔只放格式與假值，不放真正的資料庫密碼。
POS_DB_URL=jdbc:mysql://<host>.aivencloud.com:<port>/drinkshop_pos?sslMode=REQUIRED&serverTimezone=Asia/Taipei&characterEncoding=UTF-8
POS_DB_USERNAME=avnadmin
POS_DB_PASSWORD=<見共用文件>
# 啟動時建立 staff／manager／pos 測試帳號（需先執行 database/014_pos_level.sql）；沒有這兩行就無法登入。
# 不會自動開班：用 pos 帳號登入後，在畫面上選擇開班人員開班。
# 全組請使用共用文件上的同一個密碼（至少 6 碼）。
pos.demo.enabled=true
pos.demo.password=123456
HERE_API_KEY=<見共用文件>
HERE_MAP_KEY=<見共用文件>
